APP_DB_PATH=./data/app.db

# Embedding mode: local | api | mock
EMBEDDING_MODE=local

# Local embedding service (if EMBEDDING_MODE=local)
LOCAL_EMBED_ENDPOINT=http://localhost:8009/embed

# Chat / AI provider (for answers, AI ingestion, reranking)
PROVIDER_BASE_URL=https://api.deepseek.com/v1
PROVIDER_API_KEY=
PROVIDER_CHAT_MODEL=deepseek-chat

# Embedding provider (if EMBEDDING_MODE=api)
# Leave blank to use the Chat provider above
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
PROVIDER_EMBED_MODEL=text-embedding-3-small

# AI ingestion
INGEST_AI_ENABLED=true
INGEST_AI_MODEL=
INGEST_CONCURRENCY=600

# Runtime
LOG_LEVEL=INFO
