# SmartNote Cloud — PRODUCTION environment template.
# Copy to .env.prod, fill in real values, never commit the result.
#
#   cp .env.prod.example .env.prod  &&  chmod 600 .env.prod
#
# Deploy:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ─── Domains (Caddy + Let's Encrypt) ───────────────────────────────
# Both must resolve (A / AAAA) to this server's public IP before first
# bring-up — Caddy obtains TLS certs on startup via HTTP-01.
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
ACME_EMAIL=you@example.com

# ─── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=smartnote
POSTGRES_DB=smartnote
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_32_BYTES_BASE64

# ─── JWT signing (workspace API key → bearer JWT exchange) ─────────
# Strong random secret. Rotation invalidates existing JWTs; api_keys
# keep working (clients re-exchange transparently on the next call).
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX

# ─── Operational flags ─────────────────────────────────────────────
# Leave this false on prod — when true the api auto-issues an admin
# api_key on first request to /v1/dev/bootstrap, which is convenient
# for bootstrap but a foot-gun on a public deployment.
ALLOW_DEV_BOOTSTRAP=false

# ─── Embedding model (optional) ────────────────────────────────────
# Default is fast + small (384-dim, ~80 MB). For higher recall switch
# to BAAI/bge-m3 (1024-dim, ~2 GB RAM). Vector dimension must match
# what's in the DB — switching requires re-embedding existing memories.
# EMBED_MODEL=BAAI/bge-m3

# ─── Optional: Supabase auth (leave blank for api-key-only) ────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
