# SmartNote Cloud — local dev env
#
# Copy to `.env` in this directory before `docker compose up`.
# Never commit the real `.env` (already in cloud/.gitignore).

# ── Postgres ────────────────────────────────────────────────
# Defaults work for local dev; change only if you need to.
POSTGRES_USER=smartnote
POSTGRES_PASSWORD=smartnote
POSTGRES_DB=smartnote
POSTGRES_PORT=55432

# ── Embedding service ──────────────────────────────────────
# Override to try a different sentence-transformer. If you change this,
# remember to re-create any memories tables — vector dimensions change.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_PORT=58009

# ── API service ────────────────────────────────────────────
API_PORT=58000

# ── Supabase (auth) ────────────────────────────────────────
# Create a project at https://app.supabase.com → Settings → API.
# SUPABASE_URL is the REST endpoint, e.g. https://xyz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the server-side key — DO NOT ship it to
# the browser. It's only used by the api container to verify JWTs and
# mint API keys.
# SUPABASE_JWT_SECRET is the symmetric key for HS256 JWTs issued by
# Supabase Auth — used by the api container to validate end-user tokens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── SmartNote JWT signing secret ──────────────────────────
# Used to sign the short-lived JWTs that agents receive after exchanging
# their API key. Change this for prod — a compromise of this secret lets
# anyone mint tokens for any workspace.
JWT_SECRET=dev-only-change-me

# ── Dev bootstrap ─────────────────────────────────────────
# When `true`, POST /v1/dev/bootstrap is available and can create a
# tenant + workspace + admin API key without Supabase being configured.
# Set to `false` in production; it's only here so local dev + demos run
# end-to-end without standing up Supabase first.
ALLOW_DEV_BOOTSTRAP=true
