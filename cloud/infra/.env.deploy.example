# SmartNote Cloud — pull-and-run deploy env.
# Copy to `.env` on the server, fill in secrets, never commit the result.
#
#   cp .env.deploy.example .env && chmod 600 .env

# ── Which images to pull ───────────────────────────────────────────
# Must match what scripts/release-images.sh pushed.
IMAGE_PREFIX=ztzsyy/smartnote
IMAGE_TAG=latest

# ── API ────────────────────────────────────────────────────────────
# Host port the API (REST + MCP at /mcp) listens on.
API_PORT=8000

# ── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=smartnote
POSTGRES_DB=smartnote
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_32_BYTES_BASE64

# ── JWT signing (workspace API key → bearer JWT exchange) ──────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX

# ── Embedding model ────────────────────────────────────────────────
# The embed image is model-agnostic; the model downloads at runtime.
# Switch to BAAI/bge-m3 (1024-dim, ~2 GB RAM) for higher recall — note
# the vector dimension must match what's already in the DB.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── First-key bootstrap ────────────────────────────────────────────
# Flip to `true` once to mint the first admin API key via
# POST /v1/dev/bootstrap, then set back to `false` and restart.
ALLOW_DEV_BOOTSTRAP=false

# ── Optional: Supabase auth (leave blank for api-key-only) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
